# Firebase — keep the real project binding (.firebaserc) out of source control.
# Commit .firebaserc.example instead; each deployer copies it to .firebaserc.
.firebaserc
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.firebase/

# Firebase app config downloaded per-project (contains project IDs/keys)
**/google-services.json
**/GoogleService-Info.plist

# FlutterFire output — binds the app to the deployer's OWN Firebase project
# (contains projectId/appIds). Each deployer runs `flutterfire configure`,
# which regenerates this. See docs/FIREBASE_SETUP.md.
**/firebase.json
.env
.env.local
